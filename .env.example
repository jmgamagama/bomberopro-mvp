# El desarrollo local de la interfaz ya no requiere servidor backend propio,
# pero SÍ requiere conectarse al proyecto de Supabase (Base de datos + Auth).
# 
# Configuración para despliegue (Vercel, Netlify, GitHub Pages, etc.) o desarrollo local:
# 1. Copia este archivo como .env
# 2. Rellena los valores con las credenciales de tu proyecto Supabase (Project Settings -> API)

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
